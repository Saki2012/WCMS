VITE_USE_MOCK=false
VITE_LOG=false
VITE_LANG='zh-Hant-TW'
# API Server 根路徑
VITE_API_BASE_URL="/Service"
VITE_SITE_ORIGIN="http://ord.ntua.edu.tw:5173/"
VITE_AA_SITE=true


SSR_ALLOW_INSECURE_TLS=true
#SSR Server Port
PORT={SSR_Port}
SSR_API_TARGET=http://127.0.0.1:{BackEnd_Port}/

# Feature 模式不設定 VITE_SPEC_CODE。
# Spec 分支請在 .env.production.local 或部署環境變數設定 VITE_SPEC_CODE。
VITE_SPEC_CODE=1821