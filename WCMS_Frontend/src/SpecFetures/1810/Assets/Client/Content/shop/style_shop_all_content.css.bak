.shop_product-detail_section .shop-sidebar-wrap h3 {
	position: relative;
    display: block;
	
    color: #333333;
    font-size: 100%; /*16*/
	font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
	
    padding-bottom: 20px;
