.shop_product-detail_section .shop-sidebar-wrap .sidebar-widget-group .h4,
.shop_product-detail_section .shop-sidebar-wrap .sidebar-widget-group h4 {
	display: block;
	
    color: #333333;
    font-size: 93.75%; /*15*/
	font-weight: 600;
