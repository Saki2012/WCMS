VITE_USE_MOCK=false
VITE_LOG=true
VITE_LANG='zh-Hant-TW'
# API Server 根路徑
VITE_API_BASE_URL="/Service"
VITE_SITE_ORIGIN="http://127.0.0.1:5174"
VITE_AA_SITE=true
#上面那段考慮要不要留
# Node SSR listen port（IIS web.config 的 XXXX 就填這個）
PORT=5174
# 後端 API 目標（Node SSR 用來 proxy /Service）
SSR_API_TARGET=https://localhost:7030

# Feature 模式不設定 VITE_SPEC_CODE。
# Spec 分支請在 .env.development.local 或部署環境變數設定 VITE_SPEC_CODE。
VITE_SPEC_CODE=1821