<?xml version="1.0" encoding="utf-8"?> <!-- WCMS_DEPLOY_CONFIG_VERSION=2026.09.11.1 -->
<configuration>
	<system.web>
		<httpRuntime enableVersionHeader="false"/>
	</system.web>
	<system.webServer>
		<!-- IIS 只負責最外層 Proxy 與 IIS 自身標頭收斂；前台安全 Header / CSP 統一交由 Node Server。 -->
		<security>
			<requestFiltering removeServerHeader="true"/>
		</security>
		<proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false"/>
		<rewrite>
			<rules>
				<!--
					部署必填：{部署網域白名單_完整Host正則} 取自本站 IIS Bindings 與 Node SSR_ALLOWED_HOSTS，
					轉成含起訖錨點的完整 authority 正則；SSR_ALLOWED_HOSTS 的逗號清單不可直接貼入。
					本案 HTTPS 範例：^aaca\.ntua\.edu\.tw(?::443)?$
					多網域範例：^(?:www\.example\.com|example\.com)(?::443)?$
					僅列實際需要的網域與 Port；HTTP 80 或健康檢查 Host 如有需要須明確加入。
					此參數及下方 {Node執行環境_PORT} 均為部署前人工替換標記，不會由 IIS 自動讀取環境變數。
					{HTTP_HOST}、{REMOTE_ADDR}、{R:1} 等則是 IIS 原生變數，須保留。
					本規則必須位於維護頁放行與 ARR Proxy 之前；另須確認伺服器層 globalRules 未先行代理。
					拒絕 Host 不代表已消除上游設備的 DNS 查詢，部署後仍需 ADNS callback 複測。
				-->
				<rule name="Reject_Unexpected_Host" patternSyntax="ECMAScript" stopProcessing="true">
					<match url=".*"/>
					<conditions logicalGrouping="MatchAll">
						<add input="{HTTP_HOST}" pattern="{部署網域白名單_完整Host正則}" ignoreCase="true" negate="true"/>
					</conditions>
					<action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Invalid Host"/>
				</rule>
				<!-- 維護頁資源由 IIS 直接回應，不進 Node。 -->
				<rule name="MaintainPageAssets_Bypass" stopProcessing="true">
					<match url="^MaintainPage/.*"/>
					<action type="None"/>
				</rule>
				<!-- 其餘所有請求統一反向代理到 Node SSR Server。 -->
				<rule name="ReverseProxy_To_SSR_Node" stopProcessing="true">
					<match url="(.*)"/>
					<serverVariables>
						<set name="HTTP_X_FORWARDED_PROTO" value="https"/>
						<set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}"/>
						<set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}"/>
					</serverVariables>
					<action type="Rewrite" url="http://127.0.0.1:{Node執行環境_PORT}/{R:1}" appendQueryString="true"/>
				</rule>
			</rules>
			<outboundRules>
				<!-- IIS 最外層統一補 HSTS，避免 Node 未回應、維護頁、錯誤頁漏掉弱掃。 -->
				<rule name="Set_HSTS_At_IIS_Edge" enabled="true">
					<match serverVariable="RESPONSE_Strict_Transport_Security" pattern=".*"/>
					<conditions>
						<add input="{HTTPS}" pattern="on"/>
					</conditions>
					<action type="Rewrite" value="max-age=31536000; includeSubDomains"/>
				</rule>
				<!-- IIS 接手 4xx/5xx Error Response 時，僅在 CORP 缺少時補 same-origin。 -->
				<rule name="Set_CORP_For_IIS_Error_Response" enabled="true">
					<match serverVariable="RESPONSE_Cross_Origin_Resource_Policy" pattern="^$"/>
					<conditions>
						<add input="{RESPONSE_STATUS}" pattern="^[45][0-9]{2}$"/>
					</conditions>
					<action type="Rewrite" value="same-origin"/>
				</rule>
				<!-- MaintainPage 由 IIS 直接服務、不進 Node；僅在 CORP 缺少時補 same-origin。 -->
				<rule name="Set_CORP_For_MaintainPage_Response" enabled="true">
					<match serverVariable="RESPONSE_Cross_Origin_Resource_Policy" pattern="^$"/>
					<conditions>
						<add input="{REQUEST_URI}" pattern="^/MaintainPage(?:/|$)" ignoreCase="true"/>
					</conditions>
					<action type="Rewrite" value="same-origin"/>
				</rule>
				<!-- ARR 會在反向代理後補 X-Powered-By: ARR/3.0，需在 IIS 層清掉。 -->
				<rule name="Remove_X_Powered_By_ARR" preCondition="Has_X_Powered_By">
					<match serverVariable="RESPONSE_X_POWERED_BY" pattern=".+"/>
					<action type="Rewrite" value=""/>
				</rule>
				<preConditions>
					<preCondition name="Has_X_Powered_By">
						<add input="{RESPONSE_X_POWERED_BY}" pattern=".+"/>
					</preCondition>
				</preConditions>
			</outboundRules>
		</rewrite>
		<!-- Node 無法連線時，IIS 直接回維護頁。 -->
		<httpErrors errorMode="Custom" existingResponse="Replace">
			<remove statusCode="502" subStatusCode="3"/>
			<error statusCode="502" subStatusCode="3" path="MaintainPage\Maintain_Page.html" responseMode="File"/>
			<remove statusCode="502"/>
			<error statusCode="502" path="MaintainPage\Maintain_Page.html" responseMode="File"/>
			<remove statusCode="503"/>
			<error statusCode="503" path="MaintainPage\Maintain_Page.html" responseMode="File"/>
		</httpErrors>
		<httpProtocol>
			<customHeaders>
				<!-- 移除 IIS / ASP.NET 常見技術洩漏；不要在 IIS 重新 add 安全 Header，避免與 Node 重複。 -->
				<remove name="X-Powered-By"/>
				<remove name="X-AspNet-Version"/>
				<remove name="X-AspNetMvc-Version"/>
				<!-- 以下 Header 由 Node Server 統一輸出；IIS 不再加值。 -->
				<remove name="Content-Security-Policy"/>
				<remove name="Content-Security-Policy-Report-Only"/>
				<remove name="Strict-Transport-Security"/>
				<remove name="X-Frame-Options"/>
				<remove name="X-Content-Type-Options"/>
				<remove name="Referrer-Policy"/>
				<remove name="Permissions-Policy"/>
				<remove name="Cross-Origin-Opener-Policy"/>
				<remove name="X-Permitted-Cross-Domain-Policies"/>
			</customHeaders>
		</httpProtocol>
	</system.webServer>
</configuration>
