<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<system.web>
		<httpRuntime enableVersionHeader="false" />
	</system.web>
	<system.webServer>
		<security>
			<requestFiltering removeServerHeader="true" />
		</security>
		<proxy enabled="true" preserveHostHeader="true" reverseRewriteHostInResponseHeaders="false" />
		<rewrite>
			<rules>
				<rule name="MaintainPageAssets_Bypass" stopProcessing="true">
					<match url="^MaintainPage/.*" />
					<action type="None" />
				</rule>
				<rule name="ReverseProxy_To_SSR_Node" stopProcessing="true">
					<match url="(.*)" />
					<serverVariables>
						<set name="HTTP_X_FORWARDED_PROTO" value="https" />
						<set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
						<set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
					</serverVariables>
					<action type="Rewrite" url="http://127.0.0.1:{自行輸入_SSR_PORT}/{R:1}" appendQueryString="true" />
				</rule>
			</rules>
		</rewrite>

		<httpErrors errorMode="Custom" existingResponse="Replace">
			<remove statusCode="502" subStatusCode="3" />
			<error statusCode="502" subStatusCode="3" path="MaintainPage\Maintain_Page.html" responseMode="File" />
			<remove statusCode="502" />
			<error statusCode="502" path="MaintainPage\Maintain_Page.html" responseMode="File" />
			<remove statusCode="503" />
			<error statusCode="503" path="MaintainPage\Maintain_Page.html" responseMode="File" />
		</httpErrors>

		<httpProtocol>
			<customHeaders>
				<!-- 避免 IIS / ARR / ASP.NET 類型標頭外洩；上游重複送出的 X-Powered-By 仍建議在 Node 與 Backend 各自關閉。 -->
				<remove name="X-Powered-By" />
				<remove name="X-AspNet-Version" />
				<remove name="X-AspNetMvc-Version" />
				<remove name="Strict-Transport-Security" />
				<add name="Strict-Transport-Security" value="max-age=31536000" />
				<remove name="X-Frame-Options" />
				<add name="X-Frame-Options" value="SAMEORIGIN" />
				<remove name="X-Content-Type-Options" />
				<add name="X-Content-Type-Options" value="nosniff" />
				<remove name="Referrer-Policy" />
				<add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
				<remove name="Permissions-Policy" />
				<add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), fullscreen=(self)" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>
</configuration>
