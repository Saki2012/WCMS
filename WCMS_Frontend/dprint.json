{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "lineWidth": 160,
    "useTabs": false,
    "indentWidth": 4,
    "typescript": {
        "quoteStyle": "alwaysDouble",
        "semiColons": "always",
        "bracePosition": "nextLine",
        "preferHanging": false,
        "preferSingleLine": true
    },
    "plugins": [
        "https://plugins.dprint.dev/typescript-0.95.11.wasm"
    ],
    "includes": ["src/**/*.{ts,tsx}"],
    "excludes": ["node_modules"]
}