[*.cs]

# CS8600: 正在將 Null 常值或可能的 Null 值轉換為不可為 Null 的型別。
dotnet_diagnostic.CS8600.severity = none

# CS8618: 退出建構函式時，不可為 Null 的欄位必須包含非 Null 值。請考慮新增 'required' 修飾元，或將欄位宣告為可以為 Null。
dotnet_diagnostic.CS8618.severity = silent

# CS8602: 可能 null 參考的取值 (dereference)。
dotnet_diagnostic.CS8602.severity = silent

# CS8603: 可能有 Null 參考傳回。
dotnet_diagnostic.CS8603.severity = silent

# CS8604: 可能有 Null 參考引數。
dotnet_diagnostic.CS8604.severity = silent

# CS8601: 可能有 Null 參考指派。
dotnet_diagnostic.CS8601.severity = silent

# IDE0059: 指派了不必要的值
dotnet_diagnostic.IDE0059.severity = silent

# CS8629: 可為 Null 的實值型別可為 Null。
dotnet_diagnostic.CS8629.severity = silent

# CA1854: 建議使用 'IDictionary.TryGetValue(TKey，out TValue)' 方法
dotnet_diagnostic.CA1854.severity = silent

# CS8619: 值中參考型別的可 Null 性與目標型別不符合。
dotnet_diagnostic.CS8619.severity = none

# CS8625: 無法將 null 常值轉換成不可為 Null 的參考型別。
dotnet_diagnostic.CS8625.severity = silent

# IDE1006: 命名樣式
dotnet_diagnostic.IDE1006.severity = silent

# CS8981: 類型名稱只包含小寫的 ASCII 字元。此類名稱可能保留供此語言使用。
dotnet_diagnostic.CS8981.severity = silent
