	<Target Name="ValidateSpecCodeCompile" BeforeTargets="CoreCompile">
		<Message Importance="High" Text="Spec compile enabled. SettingsFile=$(SpecSettingsFile), SpecCode=$(SpecCode), HasSpecFeatureDir=$(HasCurrentSpecFeatureDir)" Condition="'$(UseSpecCodeCompile)' == 'true'" />
		<Message Importance="High" Text="SpecFeatures\$(SpecCode) does not exist. This Spec will use shared Features only." Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCode)' != '' and '$(HasCurrentSpecFeatureDir)' != 'true'" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and !Exists('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')" Text="找不到 Spec 設定檔：$(SpecSettingsFile)。請確認 appsettings 檔案存在。" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCodeFromSettings)' == ''" Text="$(SpecSettingsFile) 未設定 SpecCode，無法進行 SpecFeatures 條件編譯。" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCode)' != '' and '$(SpecCodeFromSettings)' != '' and '$(SpecCode)' != '$(SpecCodeFromSettings)'" Text="MSBuild SpecCode=$(SpecCode) 與 $(SpecSettingsFile) 的 SpecCode=$(SpecCodeFromSettings) 不一致，請修正後再編譯。" />
