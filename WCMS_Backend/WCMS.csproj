<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<!-- 明確指定 InProcess，給 IIS 用 -->
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- 佈署精簡策略 -->
		<SelfContained>false</SelfContained>            <!-- 用機器已裝的 .NET Runtime，體積最小 -->
		<PublishSingleFile>false</PublishSingleFile>     <!-- 輸出單檔（選用） -->
		<PublishTrimmed>false</PublishTrimmed>           <!-- 程式集修剪，API 專案通常相容 -->
		<TrimMode>partial</TrimMode>
		<PublishReadyToRun>true</PublishReadyToRun>     <!-- 預編譯，啟動更快（略增體積；可改 false） -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<TieredPGO>true</TieredPGO>
		<InvariantGlobalization>false</InvariantGlobalization> <!-- 若不需多文化比較可啟用以減少體積 -->
		<DebugType>portable</DebugType> <!-- 讓 ZAP/弱掃友善：不產出開發偵錯資訊到輸出 -->
	</PropertyGroup>
  <ItemGroup>
    <Compile Remove="SysCore\AccountLogin.cs" />
    <Compile Remove="SysCore\Library\RecComparison.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="C:\Users\it-016\.nuget\packages\nlog.config\4.7.15\contentFiles\any\any\NLog.config" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.BulkExtensions" Version="9.0.1" />
    <PackageReference Include="EFCore.BulkExtensions.MySql" Version="8.1.3" />
