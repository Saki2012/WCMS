<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<!-- 明確指定 InProcess，給 IIS 用 -->
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- 佈署精簡策略 -->
		<SelfContained>false</SelfContained>
		<!-- 用機器已裝的 .NET Runtime，體積最小 -->
		<PublishSingleFile>false</PublishSingleFile>
		<!-- 輸出單檔（選用） -->
		<PublishTrimmed>false</PublishTrimmed>
		<!-- 程式集修剪，API 專案通常相容 -->
		<TrimMode>partial</TrimMode>
		<PublishReadyToRun>true</PublishReadyToRun>
		<!-- 預編譯，啟動更快（略增體積；可改 false） -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<TieredPGO>true</TieredPGO>
		<InvariantGlobalization>false</InvariantGlobalization>
		<!-- 若不需多文化比較可啟用以減少體積 -->
		<DebugType>portable</DebugType>
		<!-- 讓 ZAP/弱掃友善：不產出開發偵錯資訊到輸出 -->
		<!-- 一律啟用 SpecFeatures 條件編譯，避免不同 Spec 的 partial 互相污染 -->
		<UseSpecCodeCompile Condition="'$(UseSpecCodeCompile)' == ''">true</UseSpecCodeCompile>
		<!-- Debug 預設讀 appsettings.Development.json -->
		<SpecSettingsFile Condition="'$(SpecSettingsFile)' == '' and '$(Configuration)' == 'Debug'">appsettings.Development.json</SpecSettingsFile>
		<!-- Release 預設讀 appsettings.production.json，依你目前專案檔名是小寫 production -->
		<SpecSettingsFile Condition="'$(SpecSettingsFile)' == '' and '$(Configuration)' == 'Release'">appsettings.production.json</SpecSettingsFile>
		<!-- 其他情境 fallback 到 appsettings.json -->
		<SpecSettingsFile Condition="'$(SpecSettingsFile)' == ''">appsettings.json</SpecSettingsFile>
		<!-- 從 appsettings.*.json 讀取 SpecCode，作為編譯期 SpecCode 來源 -->
		<SpecCodeFromSettings Condition="Exists('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')), '"SpecCode"\s*:\s*"([^"]+)"').Groups[1].Value)</SpecCodeFromSettings>
		<!-- 若外部沒有傳入 SpecCode，則使用 appsettings 內的 SpecCode -->
		<SpecCode Condition="'$(SpecCode)' == ''">$(SpecCodeFromSettings)</SpecCode>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="SysCore\AccountLogin.cs" />
		<Compile Remove="SysCore\Library\RecComparison.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseSpecCodeCompile)' == 'true'">
		<!-- 啟用條件編譯時，先移除全部 SpecFeatures 的 C# 與 Resx -->
		<Compile Remove="SpecFeatures\**\*.cs" />
		<EmbeddedResource Remove="SpecFeatures\**\*.resx" />
	</ItemGroup>
	<ItemGroup Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCode)' != ''">
		<!-- SpecCode 有值時，只加回目前 SpecCode 對應的 C# 與 Resx -->
		<Compile Include="SpecFeatures\$(SpecCode)\**\*.cs" />
		<EmbeddedResource Include="SpecFeatures\$(SpecCode)\**\*.resx" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="C:\Users\it-016\.nuget\packages\nlog.config\4.7.15\contentFiles\any\any\NLog.config" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="EFCore.BulkExtensions" Version="9.0.1" />
		<PackageReference Include="EFCore.BulkExtensions.MySql" Version="8.1.3" />
		<PackageReference Include="GraphQL" Version="8.5.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
		<PackageReference Include="JWT" Version="11.0.0" />
		<PackageReference Include="MessagePack" Version="3.1.4" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.19" />
		<PackageReference Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" Version="8.0.19" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
		<PackageReference Include="Microsoft.Playwright" Version="1.57.0" />
		<PackageReference Include="Mime-Detective" Version="25.8.1" />
		<PackageReference Include="Mime-Detective.Definitions.Condensed" Version="25.8.1" />
		<PackageReference Include="Mime-Detective.Definitions.Exhaustive" Version="25.8.1" />
		<PackageReference Include="NLog" Version="6.0.3" />
		<PackageReference Include="NLog.Schema" Version="6.0.3" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<PackageReference Include="SharpCompress" Version="0.40.0" />
		<PackageReference Include="StackExchange.Redis" Version="2.8.58" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.7" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Features\MAT\" />
		<Folder Include="Features\SYS\" />
		<Folder Include="SysCore\NLogger\DataChange\" />
		<Folder Include="SysCore\NLogger\Operate\" />
		<Folder Include="SysCore\NLogger\Sys\" />
	</ItemGroup>
	<ItemGroup>
		<Content Update="NLog.config">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<!-- 將 UDF 腳本複製到輸出與發佈資料夾 -->
		<None Include="SysCore\UDF\**\*.sql">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
	</ItemGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!-- 不要自動產生/轉換 web.config（避免發布時又長出一份預設檔） -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	</PropertyGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<!-- 只發佈 appsettings.json -->
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
		<Content Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
		<!-- 禁止發佈/輸出 appsettings.{Env}.json（Dev/Prod/Staging…） -->
		<None Update="appsettings.*.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
		<Content Update="appsettings.*.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<!-- 你的 web.config 保持發佈 -->
		<Content Update="web.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Publish\**" />
		<Compile Remove="SysCore\SystemFunc\UserRolePermission\**" />
		<Content Remove="Publish\**" />
		<Content Remove="SysCore\SystemFunc\UserRolePermission\**" />
		<EmbeddedResource Remove="Publish\**" />
		<EmbeddedResource Remove="SysCore\SystemFunc\UserRolePermission\**" />
		<None Remove="Publish\**" />
		<None Remove="SysCore\SystemFunc\UserRolePermission\**" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Scripts\Zip-PublishedBackend.ps1" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="SpecFeatures\Spec1816\_Resx\SpecMessageCode.zh-TW.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="SpecFeatures\Spec1817\_Resx\SpecMessageCode.zh-TW.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="SpecFeatures\Spec1810\_Resx\SpecMessageCode.zh-TW.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="SpecFeatures\Spec1820\_Resx\SpecMessageCode.zh-TW.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>
	<Target Name="ValidateSpecCodeCompile" BeforeTargets="CoreCompile">
		<Message Importance="High" Text="Spec compile enabled. SettingsFile=$(SpecSettingsFile), SpecCode=$(SpecCode)" Condition="'$(UseSpecCodeCompile)' == 'true'" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and !Exists('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')" Text="找不到 Spec 設定檔：$(SpecSettingsFile)。請確認 appsettings 檔案存在。" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCodeFromSettings)' == ''" Text="$(SpecSettingsFile) 未設定 SpecCode，無法進行 SpecFeatures 條件編譯。" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCode)' != '' and '$(SpecCodeFromSettings)' != '' and '$(SpecCode)' != '$(SpecCodeFromSettings)'" Text="MSBuild SpecCode=$(SpecCode) 與 $(SpecSettingsFile) 的 SpecCode=$(SpecCodeFromSettings) 不一致，請修正後再編譯。" />
		<Error Condition="'$(UseSpecCodeCompile)' == 'true' and '$(SpecCode)' != '' and !Exists('$(MSBuildProjectDirectory)\SpecFeatures\$(SpecCode)')" Text="找不到 SpecFeatures\$(SpecCode) 資料夾，請確認 SpecCode 是否正確。" />
	</Target>
</Project>
