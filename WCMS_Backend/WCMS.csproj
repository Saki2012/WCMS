<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- 佈署精簡策略 -->
		<SelfContained>false</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<PublishReadyToRun>true</PublishReadyToRun>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<TieredPGO>true</TieredPGO>
		<InvariantGlobalization>false</InvariantGlobalization>
		<DebugType>portable</DebugType>
		<!-- 保留 SpecFeatures 條件編譯能力；純 Feature 模式可使用空白 SpecCode -->
		<UseSpecCodeCompile Condition="'$(UseSpecCodeCompile)' == ''">true</UseSpecCodeCompile>
		<!-- Debug 預設讀 appsettings.Development.json -->
		<SpecSettingsFile Condition="'$(SpecSettingsFile)' == '' and '$(Configuration)' == 'Debug'">appsettings.Development.json</SpecSettingsFile>
		<!-- Release 預設讀 appsettings.production.json -->
		<SpecSettingsFile Condition="'$(SpecSettingsFile)' == '' and '$(Configuration)' == 'Release'">appsettings.production.json</SpecSettingsFile>
		<!-- 其他情境 fallback 到 appsettings.json -->
		<SpecSettingsFile Condition="'$(SpecSettingsFile)' == ''">appsettings.json</SpecSettingsFile>
		<!-- 從 appsettings.*.json 讀取 SpecCode，作為編譯期 SpecCode 來源 -->
		<SpecCodeFromSettings Condition="Exists('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')), '"SpecCode"\s*:\s*"([^"]+)"').Groups[1].Value)</SpecCodeFromSettings>
		<!-- 若外部沒有傳入 SpecCode，則使用 appsettings 內的 SpecCode -->
		<SpecCode Condition="'$(SpecCode)' == ''">$(SpecCodeFromSettings)</SpecCode>
		<!-- 目前 SpecFeature 資料夾；不存在代表該 Spec 沒有客製化程式 -->
		<CurrentSpecFeatureDir>$(MSBuildProjectDirectory)\SpecFeatures\$(SpecCode)</CurrentSpecFeatureDir>
		<HasCurrentSpecFeatureDir Condition="'$(SpecCode)' != '' and Exists('$(CurrentSpecFeatureDir)')">true</HasCurrentSpecFeatureDir>
		<HasCurrentSpecFeatureDir Condition="'$(HasCurrentSpecFeatureDir)' == ''">false</HasCurrentSpecFeatureDir>
		<!-- 開發 / 發佈實際編譯時啟用 SpecFeatures 過濾；不使用 DefaultItemExcludes，避免 IDE 找不到其他 Spec 檔案 -->
		<!-- 只有明確設定 SpecCode 時，才啟用 SpecFeatures 條件編譯。 -->
		<EnableSpecCompileFilter Condition="'$(EnableSpecCompileFilter)' == '' and '$(UseSpecCodeCompile)' == 'true' and '$(SpecCode)' != ''">true</EnableSpecCompileFilter>
		<EnableSpecCompileFilter Condition="'$(EnableSpecCompileFilter)' == ''">false</EnableSpecCompileFilter>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<!-- 不要自動產生 / 轉換 web.config，避免發布時又長出一份預設檔 -->
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="SysCore\AccountLogin.cs" />
		<Compile Remove="SysCore\Library\RecComparison.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
		<PackageReference Include="Mime-Detective" Version="25.8.1" />
		<PackageReference Include="NLog" Version="6.1.4" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Features\MAT\" />
		<Folder Include="Features\SYS\" />
	</ItemGroup>
	<ItemGroup>
		<!-- 將 UDF 腳本複製到輸出與發佈資料夾 -->
		<None Include="SysCore\Persistence\Udf\**\*.sql">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		<!-- 只發佈 appsettings.json -->
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
		<Content Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
		<!-- 禁止發佈 / 輸出 appsettings.{Env}.json -->
		<None Update="appsettings.*.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
		<Content Update="appsettings.*.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</Content>
		<!-- web.config 保持發佈 -->
		<Content Update="web.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Publish\**" />
		<Compile Remove="SysCore\PlatformServices\UserRolePermission\**" />
		<Content Remove="Publish\**" />
		<Content Remove="SysCore\PlatformServices\UserRolePermission\**" />
		<EmbeddedResource Remove="Publish\**" />
		<EmbeddedResource Remove="SysCore\PlatformServices\UserRolePermission\**" />
		<None Remove="Publish\**" />
		<None Remove="SysCore\PlatformServices\UserRolePermission\**" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Scripts\Zip-PublishedBackend.ps1" />
	</ItemGroup>
	<Target Name="ValidateSpecCodeCompile" BeforeTargets="CoreCompile">
		<Message Importance="High" Text="Spec compile enabled. SettingsFile=$(SpecSettingsFile), SpecCode=$(SpecCode), HasSpecFeatureDir=$(HasCurrentSpecFeatureDir), EnableSpecCompileFilter=$(EnableSpecCompileFilter)" Condition="'$(EnableSpecCompileFilter)' == 'true'" />
		<Message Importance="High" Text="SpecFeatures\$(SpecCode) does not exist. This Spec will use shared Features only." Condition="'$(EnableSpecCompileFilter)' == 'true' and '$(SpecCode)' != '' and '$(HasCurrentSpecFeatureDir)' != 'true'" />
		<Error Condition="'$(EnableSpecCompileFilter)' == 'true' and !Exists('$(MSBuildProjectDirectory)\$(SpecSettingsFile)')" Text="找不到 Spec 設定檔：$(SpecSettingsFile)。請確認 appsettings 檔案存在。" />
		<Error Condition="'$(EnableSpecCompileFilter)' == 'true' and '$(SpecCodeFromSettings)' == ''" Text="$(SpecSettingsFile) 未設定 SpecCode，無法進行 SpecFeatures 條件編譯。" />
		<Error Condition="'$(EnableSpecCompileFilter)' == 'true' and '$(SpecCode)' != '' and '$(SpecCodeFromSettings)' != '' and '$(SpecCode)' != '$(SpecCodeFromSettings)'" Text="MSBuild SpecCode=$(SpecCode) 與 $(SpecSettingsFile) 的 SpecCode=$(SpecCodeFromSettings) 不一致，請修正後再編譯。" />
	</Target>
</Project>
