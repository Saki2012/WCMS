<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	<!-- 明確指定 InProcess，給 IIS 用 -->
	<AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<!-- 佈署精簡策略 -->
    <SelfContained>false</SelfContained>            <!-- 用機器已裝的 .NET Runtime，體積最小 -->
    <PublishSingleFile>false</PublishSingleFile>     <!-- 輸出單檔（選用） -->
    <PublishTrimmed>false</PublishTrimmed>           <!-- 程式集修剪，API 專案通常相容 -->
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>     <!-- 預編譯，啟動更快（略增體積；可改 false） -->
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
	<TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization> <!-- 若不需多文化比較可啟用以減少體積 -->
    <DebugType>portable</DebugType> <!-- 讓 ZAP/弱掃友善：不產出開發偵錯資訊到輸出 -->
	
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SysCore\AccountLogin.cs" />
    <Compile Remove="SysCore\Library\RecComparison.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.BulkExtensions" Version="9.0.1" />
    <PackageReference Include="EFCore.BulkExtensions.MySql" Version="8.1.3" />
    <PackageReference Include="GraphQL" Version="8.5.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
    <PackageReference Include="JWT" Version="11.0.0" />
    <PackageReference Include="MessagePack" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" Version="8.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.8" />
    <PackageReference Include="Mime-Detective" Version="25.8.1" />
    <PackageReference Include="Mime-Detective.Definitions.Condensed" Version="25.8.1" />
    <PackageReference Include="Mime-Detective.Definitions.Exhaustive" Version="25.8.1" />
    <PackageReference Include="SharpCompress" Version="0.40.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.7" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\Finance\" />
    <Folder Include="Features\BizResx\" />
    <Folder Include="Features\SiteEdit\PCS_Sites\" />
    <Folder Include="Features\SystemSetting\SiteInfo\EnvConfig\" />
    <Folder Include="Features\SystemSetting\SiteInfo\SiteArch\" />
    <Folder Include="Features\SystemSetting\SiteInfo\SEO\" />
    <Folder Include="Features\SystemSetting\SiteInfo\SystemInfo\" />
    <Folder Include="Features\SystemSetting\DataChangeLog\" />
    <Folder Include="Features\SystemSetting\AccountManage\" />
    <Folder Include="Features\SystemSetting\RolePermission\" />
    <Folder Include="Features\SystemSetting\OperateLog\" />
    <Folder Include="Features\SystemSetting\UserAccount\" />
    <Folder Include="Migrations\" />
    <Folder Include="SysCore\NLogger\DataChange\" />
    <Folder Include="SysCore\NLogger\Operate\" />
    <Folder Include="SysCore\NLogger\Sys\" />
  </ItemGroup>
</Project>
